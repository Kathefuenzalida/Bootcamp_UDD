<!DOCTYPE html>
<html>
<head>
    <title>Editar Evento</title>
</head>
<body>
    <h1>Editar Evento</h1>
    <form action="/eventos/<%= evento._id %>?_method=PUT" method="POST">
        <input type="text" name="titulo" value="<%= evento.titulo %>" required><br>
        <textarea name="descripcion"><%= evento.descripcion %></textarea><br>
        <input type="date" name="fecha" value="<%= evento.fecha.toISOString().split('T')[0] %>" required><br>
        <input type="text" name="ubicacion" value="<%= evento.ubicacion %>"><br>
        <button type="submit">Actualizar Evento</button>
    </form>
    <a href="/">Volver</a>
</body>
</html>
