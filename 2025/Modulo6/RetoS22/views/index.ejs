<!DOCTYPE html>
<html>
<head>
    <title>Eventos</title>
</head>
<body>
    <h1>Lista de Eventos</h1>
    <a href="/eventos/nuevo">Agregar Evento</a>
    <ul>
        <% eventos.forEach(evento => { %>
            <li>
                <strong><%= evento.titulo %></strong> - <%= new Date(evento.fecha).toDateString() %>
                - <%= evento.ubicacion %>
                <a href="/eventos/<%= evento._id %>/editar">Editar</a>
                <form action="/eventos/<%= evento._id %>?_method=DELETE" method="POST" style="display:inline;">
                    <button type="submit">Eliminar</button>
                </form>
            </li>
        <% }) %>
    </ul>
</body>
</html>
